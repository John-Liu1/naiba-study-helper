{
  "manifest_version": 3,
  "name": "学习通 LLM 学习助手",
  "version": "0.4.3",
  "description": "用你自己的大模型辅助学习通章节学习：扫描任务点、解析题目、作答与核对。",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.chaoxing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["content/bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["content/early.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["content/main.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习通 LLM 助手"
  }
}
